{
  "name": "blockflow",
  "version": "0.1.0",
  "private": true,
  "description": "BPMN 다이어그램으로 스마트 컨트랙트를 생성하고 제어하는 비전문가용 도구",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "codegen": "tsx packages/codegen/src/cli.ts",
    "bpmn": "tsx packages/bpmn/src/cli.ts",
    "gen:examples": "tsx packages/bpmn/src/cli.ts all packages/bpmn/examples contracts/src contracts/test/generated",
    "lint:bpmn": "for f in packages/bpmn/examples/*.bpmn; do tsx packages/bpmn/src/cli.ts lint \"$f\" || exit 1; done",
    "check:sound": "tsx packages/validator/src/cli.ts packages/ir/examples/*.json",
    "modeler": "pnpm --filter @blockflow/modeler dev",
    "modeler:build": "pnpm --filter @blockflow/modeler build",
    "modeler:e2e": "pnpm --filter @blockflow/modeler e2e"
  },
  "dependencies": {
    "bpmn-moddle": "^10.2.0"
  },
  "devDependencies": {
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/tx": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@ethereumjs/vm": "^10.1.3",
    "@types/mustache": "^4.2.5",
    "@types/node": "^22.15.0",
    "ajv": "^8.17.0",
    "mustache": "^4.2.0",
    "solc": "0.8.37",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "viem": "^2.56.5",
    "vitest": "^3.2.0"
  },
  "dependencies": {
  }
}
