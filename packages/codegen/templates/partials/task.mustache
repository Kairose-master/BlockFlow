    {{doc}}
    function {{name}}({{params}})
        external
        whenNotPaused
        onlyRole(id, {{roleConst}})
{{#payment}}
        nonReentrant
{{/payment}}
    {
        _require(id, {{inMask}}, {{taskConst}});
{{#sets}}
        vars[id].{{variable}} = {{param}};
{{/sets}}
        _fire(id, {{inMask}}, {{outMask}}, {{taskConst}});
{{#payment}}
        // 결제 (checks-effects-interactions: 상태 전이 뒤에 외부 호출)
        if (!IERC20({{token}}).transferFrom(msg.sender, {{to}}, vars[id].{{amountVar}})) revert PaymentFailed();
{{/payment}}
    }

